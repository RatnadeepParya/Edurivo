# Application Environment
NODE_ENV=development
PORT=3000
APP_NAME=Edurivo
APP_URL=http://localhost:3000
SESSION_SECRET=super_secret_session_key_change_in_production_32chars!

# Firebase Admin Configuration
# Option A: Path to Service Account JSON
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: Direct credentials
FIREBASE_PROJECT_ID=edurivo-school
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=https://edurivo-school-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=edurivo-school.appspot.com

# Firebase Emulators (Leave empty for production or live Firebase)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Feature Toggles
FCM_ENABLED=false
OFFLINE_DEV_MODE=true

# Payment Gateway (Abstracted)
PAYMENT_PROVIDER=MOCK
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
