<%- include('../../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Examination Management</h1>
    <div class="page-subtitle">Schedule exams, enter grades and publish immutable official results</div>
  </div>
  <button type="button" class="btn btn-primary" data-modal-target="createExamModal">+ Schedule New Exam</button>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Exam Name</th>
          <th>Type</th>
          <th>Start Date</th>
          <th>End Date</th>
          <th>Status</th>
          <th style="text-align: right;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (exams && exams.length > 0) { %>
          <% exams.forEach(ex => { %>
            <tr>
              <td><strong><%= ex.name %></strong></td>
              <td><span class="badge badge-info"><%= ex.type %></span></td>
              <td><%= ex.startDate %></td>
              <td><%= ex.endDate %></td>
              <td>
                <span class="badge <%= ex.isPublished ? 'badge-success' : 'badge-warning' %>">
                  <%= ex.isPublished ? 'PUBLISHED' : ex.status %>
                </span>
              </td>
              <td style="text-align: right;">
                <% if (!ex.isPublished) { %>
                  <form action="/admin/exams/<%= ex.id %>/publish" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to publish results? Once published, results are locked from silent edits.')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-success btn-sm">Publish Results</button>
                  </form>
                <% } else { %>
                  <span style="font-size: 12px; color: var(--success); font-weight: 600;">✓ Official Results Locked</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 32px;">No exams scheduled.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Schedule Exam Modal -->
<div id="createExamModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <h3 style="font-size: 16px; font-weight: 700;">Schedule Examination</h3>
      <button type="button" data-modal-close style="border:none;background:none;font-size:20px;cursor:pointer;">&times;</button>
    </div>
    <form action="/admin/exams" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="exName">Exam Name *</label>
          <input type="text" id="exName" name="name" class="form-control" required placeholder="e.g. Midterm Assessment 2025">
        </div>
        <div class="form-group">
          <label class="form-label" for="exType">Exam Type *</label>
          <select id="exType" name="type" class="form-control" required>
            <option value="UNIT_TEST">Unit Test</option>
            <option value="HALF_YEARLY">Half Yearly</option>
            <option value="ANNUAL">Annual Examination</option>
            <option value="PRE_BOARD">Pre-Board</option>
            <option value="TERM_EXAM">Term Exam</option>
          </select>
        </div>
        <div class="form-row">
          <div class="form-col">
            <label class="form-label" for="exStart">Start Date *</label>
            <input type="date" id="exStart" name="startDate" class="form-control" required>
          </div>
          <div class="form-col">
            <label class="form-label" for="exEnd">End Date *</label>
            <input type="date" id="exEnd" name="endDate" class="form-control" required>
          </div>
        </div>
        <input type="hidden" name="academicSessionId" value="session_2025_2026">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary">Save Exam</button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
