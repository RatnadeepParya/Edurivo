<%- include('../../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Faculty & Staff Directory</h1>
    <div class="page-subtitle">Manage educators, staff designations, and departmental assignments</div>
  </div>
  <button type="button" class="btn btn-primary" data-modal-target="addTeacherModal">+ Add New Teacher</button>
</div>

<!-- Teachers Table -->
<div class="card">
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Employee ID</th>
          <th>Faculty Name</th>
          <th>Department</th>
          <th>Designation</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (teachers && teachers.length > 0) { %>
          <% teachers.forEach(t => { %>
            <tr>
              <td><strong><%= t.employeeId %></strong></td>
              <td><strong><%= t.name %></strong></td>
              <td><span class="badge badge-info"><%= t.department || 'Academics' %></span></td>
              <td><%= t.designation || 'Teacher' %></td>
              <td><%= t.email %></td>
              <td><%= t.phone || '-' %></td>
              <td><span class="badge badge-success"><%= t.status || 'ACTIVE' %></span></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 32px;">
              No faculty records registered yet.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Add Teacher Modal -->
<div id="addTeacherModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <h3 style="font-size: 16px; font-weight: 700;">Add Faculty Member</h3>
      <button type="button" data-modal-close style="border:none;background:none;font-size:20px;cursor:pointer;">&times;</button>
    </div>
    <form action="/admin/teachers" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="tName">Full Name *</label>
          <input type="text" id="tName" name="name" class="form-control" required placeholder="e.g. Dr. Eleanor Gray">
        </div>
        <div class="form-row">
          <div class="form-col">
            <label class="form-label" for="tEmail">Email Address *</label>
            <input type="email" id="tEmail" name="email" class="form-control" required placeholder="egray@edurivo.edu">
          </div>
          <div class="form-col">
            <label class="form-label" for="tPhone">Phone Number</label>
            <input type="text" id="tPhone" name="phone" class="form-control" placeholder="+1 555-0182">
          </div>
        </div>
        <div class="form-row mt-4">
          <div class="form-col">
            <label class="form-label" for="tDept">Department</label>
            <select id="tDept" name="department" class="form-control">
              <option value="Mathematics">Mathematics</option>
              <option value="Science">Science</option>
              <option value="Languages">Languages</option>
              <option value="Social Studies">Social Studies</option>
              <option value="Arts & Sports">Arts & Sports</option>
            </select>
          </div>
          <div class="form-col">
            <label class="form-label" for="tDesig">Designation</label>
            <input type="text" id="tDesig" name="designation" class="form-control" value="Senior Faculty">
          </div>
        </div>
        <div class="form-row mt-4">
          <div class="form-col">
            <label class="form-label" for="tSalary">Base Monthly Salary ($)</label>
            <input type="number" id="tSalary" name="salary" class="form-control" value="4500" step="50">
          </div>
          <div class="form-col">
            <label class="form-label" for="tQual">Qualification</label>
            <input type="text" id="tQual" name="qualification" class="form-control" placeholder="M.Sc., B.Ed.">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary">Save Faculty Member</button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
