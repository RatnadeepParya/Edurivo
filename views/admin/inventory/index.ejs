<%- include('../../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Inventory & Stock Movement Ledger</h1>
    <div class="page-subtitle">Track stationery, equipment, consumable supplies, and auditable stock flows</div>
  </div>
  <div style="display: flex; gap: 10px;">
    <button type="button" class="btn btn-primary" data-modal-target="addItemModal">+ Add Item</button>
    <button type="button" class="btn btn-secondary" data-modal-target="recordMovementModal">Record Movement</button>
  </div>
</div>

<% if (lowStock && lowStock.length > 0) { %>
  <div class="alert alert-danger mb-6">
    <span>⚠️</span>
    <span><strong>Low Stock Warning:</strong> <%= lowStock.length %> items are below minimum replenishment threshold!</span>
  </div>
<% } %>

<div class="flex gap-6" style="flex-wrap: wrap;">
  <!-- Inventory Items -->
  <div style="flex: 2; min-width: 380px;">
    <div class="card mb-6">
      <div class="card-header">
        <h2 class="card-title">Inventory Items & Current Stock</h2>
      </div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Item Name</th>
              <th>Category</th>
              <th>Quantity in Hand</th>
              <th>Min Alert Level</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (items && items.length > 0) { %>
              <% items.forEach(it => { %>
                <tr>
                  <td><strong><%= it.name %></strong></td>
                  <td><span class="badge badge-neutral"><%= it.category %></span></td>
                  <td><strong><%= it.quantity %></strong> <%= it.unit || 'units' %></td>
                  <td><%= it.minStockAlert %></td>
                  <td>
                    <span class="badge <%= it.quantity <= it.minStockAlert ? 'badge-danger' : 'badge-success' %>">
                      <%= it.quantity <= it.minStockAlert ? 'LOW STOCK' : 'ADEQUATE' %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" style="text-align: center; color: var(--text-muted); padding: 32px;">No inventory items recorded.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Movements Ledger -->
  <div style="flex: 1; min-width: 320px;">
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">📜 Movement Ledger</h2>
      </div>
      <ul style="list-style: none;">
        <% if (movements && movements.length > 0) { %>
          <% movements.forEach(m => { %>
            <li style="padding: 10px 0; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
              <div>
                <strong><%= m.itemName %></strong>
                <div style="font-size: 11px; color: var(--text-muted);"><%= m.reason || m.type %> (<%= m.type %>)</div>
              </div>
              <div>
                <span class="badge <%= m.type === 'STOCK_IN' ? 'badge-success' : 'badge-danger' %>">
                  <%= m.type === 'STOCK_IN' ? '+' : '-' %><%= m.quantity %>
                </span>
              </div>
            </li>
          <% }) %>
        <% } else { %>
          <li style="color: var(--text-muted); font-size: 13px;">No stock movements logged.</li>
        <% } %>
      </ul>
    </div>
  </div>
</div>

<!-- Add Item Modal -->
<div id="addItemModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <h3 style="font-size: 16px; font-weight: 700;">Add Inventory Item</h3>
      <button type="button" data-modal-close style="border:none;background:none;font-size:20px;cursor:pointer;">&times;</button>
    </div>
    <form action="/admin/inventory/items" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="invName">Item Name *</label>
          <input type="text" id="invName" name="name" class="form-control" required placeholder="e.g. A4 Copy Paper">
        </div>
        <div class="form-row">
          <div class="form-col">
            <label class="form-label" for="invCat">Category</label>
            <select id="invCat" name="category" class="form-control">
              <option value="Stationery">Stationery</option>
              <option value="Lab Equipment">Lab Equipment</option>
              <option value="Sports Goods">Sports Goods</option>
              <option value="Furniture">Furniture</option>
            </select>
          </div>
          <div class="form-col">
            <label class="form-label" for="invQty">Initial Quantity</label>
            <input type="number" id="invQty" name="quantity" class="form-control" value="10" min="0">
          </div>
        </div>
        <div class="form-group mt-4">
          <label class="form-label" for="invMin">Low Stock Alert Threshold</label>
          <input type="number" id="invMin" name="minStockAlert" class="form-control" value="5" min="1">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary">Create Item</button>
      </div>
    </form>
  </div>
</div>

<!-- Record Movement Modal -->
<div id="recordMovementModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <h3 style="font-size: 16px; font-weight: 700;">Record Stock Movement</h3>
      <button type="button" data-modal-close style="border:none;background:none;font-size:20px;cursor:pointer;">&times;</button>
    </div>
    <form action="/admin/inventory/movements" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="movItem">Select Item *</label>
          <select id="movItem" name="itemId" class="form-control" required>
            <% items.forEach(it => { %>
              <option value="<%= it.id %>"><%= it.name %> (Stock: <%= it.quantity %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-row">
          <div class="form-col">
            <label class="form-label" for="movType">Movement Type *</label>
            <select id="movType" name="type" class="form-control" required>
              <option value="STOCK_IN">Stock Intake (Restock)</option>
              <option value="STOCK_OUT">Stock Issue (Consumption)</option>
              <option value="ADJUSTMENT">Audit Adjustment</option>
              <option value="SCRAP">Scrap / Damaged</option>
            </select>
          </div>
          <div class="form-col">
            <label class="form-label" for="movQty">Quantity *</label>
            <input type="number" id="movQty" name="quantity" class="form-control" required min="1" value="1">
          </div>
        </div>
        <div class="form-group mt-4">
          <label class="form-label" for="movReason">Reason / Reference *</label>
          <input type="text" id="movReason" name="reason" class="form-control" required placeholder="e.g. Issued to Science Lab">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary">Commit Ledger Entry</button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
