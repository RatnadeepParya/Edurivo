<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Identity Card - <%= student.firstName %> <%= student.lastName %> | Edurivo</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    body {
      background-color: #f1f5f9;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      padding: 24px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .print-actions {
      margin-bottom: 24px;
      display: flex;
      gap: 12px;
    }
    .id-card-wrapper {
      display: flex;
      gap: 24px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .id-card {
      width: 320px;
      height: 480px;
      background: #ffffff;
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      border: 1px solid #e2e8f0;
      position: relative;
    }
    .card-banner {
      background: linear-gradient(135deg, #4f46e5 0%, #2563eb 100%);
      color: #ffffff;
      padding: 16px;
      text-align: center;
    }
    .school-name {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .school-sub {
      font-size: 11px;
      opacity: 0.9;
      margin-top: 2px;
    }
    .photo-container {
      display: flex;
      justify-content: center;
      margin-top: -30px;
      margin-bottom: 8px;
    }
    .student-photo {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      border: 4px solid #ffffff;
      background: #e2e8f0;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      color: #64748b;
      overflow: hidden;
    }
    .student-name {
      text-align: center;
      font-size: 18px;
      font-weight: 700;
      color: #0f172a;
      margin: 0;
    }
    .student-role {
      text-align: center;
      font-size: 12px;
      font-weight: 600;
      color: #4f46e5;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 2px;
    }
    .id-details {
      padding: 12px 20px;
      flex: 1;
    }
    .detail-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 12px;
      border-bottom: 1px dashed #f1f5f9;
      padding-bottom: 4px;
    }
    .detail-label {
      color: #64748b;
      font-weight: 500;
    }
    .detail-val {
      color: #0f172a;
      font-weight: 600;
    }
    .card-footer {
      background: #f8fafc;
      padding: 12px 20px;
      border-top: 1px solid #e2e8f0;
      text-align: center;
    }
    .barcode {
      height: 30px;
      background: repeating-linear-gradient(90deg, #000, #000 2px, #fff 2px, #fff 4px, #000 4px, #000 7px, #fff 7px, #fff 9px);
      margin-bottom: 6px;
    }
    .emergency-text {
      font-size: 10px;
      color: #dc2626;
      font-weight: 600;
    }
    @media print {
      body {
        background: transparent;
        padding: 0;
      }
      .print-actions {
        display: none !important;
      }
      .id-card {
        box-shadow: none;
        page-break-inside: avoid;
        border: 1px solid #94a3b8;
      }
    }
  </style>
</head>
<body>
  <div class="print-actions">
    <button onclick="window.print()" class="btn btn-primary">🖨️ Print Student Badge</button>
    <a href="/admin/students/<%= student.id %>" class="btn btn-secondary">← Back to Profile</a>
  </div>

  <div class="id-card-wrapper">
    <!-- ID Card Front -->
    <div class="id-card">
      <div class="card-banner">
        <div class="school-name"><%= school.name || 'Edurivo International Academy' %></div>
        <div class="school-sub">STUDENT IDENTITY CARD</div>
      </div>

      <div class="photo-container">
        <div class="student-photo">
          <% if (student.photoUrl) { %>
            <img src="<%= student.photoUrl %>" alt="Photo" style="width: 100%; height: 100%; object-fit: cover;">
          <% } else { %>
            👨‍🎓
          <% } %>
        </div>
      </div>

      <h2 class="student-name"><%= student.firstName %> <%= student.lastName %></h2>
      <div class="student-role">Student Pass</div>

      <div class="id-details">
        <div class="detail-row">
          <span class="detail-label">Admission No</span>
          <span class="detail-val"><%= student.admissionNumber %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Class & Section</span>
          <span class="detail-val"><%= student.className || 'Class 10' %> - <%= student.sectionName || 'A' %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Roll Number</span>
          <span class="detail-val"><%= student.rollNumber || '01' %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Blood Group</span>
          <span class="detail-val"><%= student.bloodGroup || 'O+' %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Emergency Phone</span>
          <span class="detail-val"><%= student.emergencyContact || student.parentPhone || school.phone || '911' %></span>
        </div>
      </div>

      <div class="card-footer">
        <div class="barcode"></div>
        <div style="font-size: 10px; color: #64748b; font-family: monospace;"><%= student.admissionNumber %></div>
        <div class="emergency-text">IF FOUND, PLEASE RETURN TO SCHOOL ADMINISTRATION</div>
      </div>
    </div>
  </div>
</body>
</html>
