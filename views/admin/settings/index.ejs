<%- include('../../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Institutional Configuration</h1>
    <div class="page-subtitle">School metadata, branding, numbering conventions, and regional preferences</div>
  </div>
</div>

<div class="card" style="max-width: 800px;">
  <form action="/admin/settings" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-row">
      <div class="form-col">
        <label class="form-label" for="schName">School Name *</label>
        <input type="text" id="schName" name="name" class="form-control" required value="<%= settings.name %>">
      </div>
      <div class="form-col">
        <label class="form-label" for="schTagline">Tagline</label>
        <input type="text" id="schTagline" name="tagline" class="form-control" value="<%= settings.tagline || '' %>">
      </div>
    </div>

    <div class="form-row mt-4">
      <div class="form-col">
        <label class="form-label" for="schEmail">Official Email *</label>
        <input type="email" id="schEmail" name="email" class="form-control" required value="<%= settings.email %>">
      </div>
      <div class="form-col">
        <label class="form-label" for="schPhone">Phone Number *</label>
        <input type="text" id="schPhone" name="phone" class="form-control" required value="<%= settings.phone %>">
      </div>
    </div>

    <div class="form-group mt-4">
      <label class="form-label" for="schAddress">Campus Address *</label>
      <input type="text" id="schAddress" name="address" class="form-control" required value="<%= settings.address %>">
    </div>

    <div class="form-row mt-4">
      <div class="form-col">
        <label class="form-label" for="schCur">Currency Symbol</label>
        <input type="text" id="schCur" name="currencySymbol" class="form-control" value="<%= settings.currencySymbol || '$' %>">
      </div>
      <div class="form-col">
        <label class="form-label" for="schRecPrefix">Receipt Prefix</label>
        <input type="text" id="schRecPrefix" name="receiptPrefix" class="form-control" value="<%= settings.receiptPrefix || 'REC' %>">
      </div>
    </div>

    <div style="margin-top: 24px;">
      <button type="submit" class="btn btn-primary btn-lg">Save Configuration</button>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
