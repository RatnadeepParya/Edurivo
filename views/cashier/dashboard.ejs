<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Cashier Financial Counter</h1>
    <div class="page-subtitle">Daily fee collections, drawer reconciliations, and payment processing</div>
  </div>
  <div style="display: flex; gap: 10px;">
    <a href="/cashier/collect" class="btn btn-success btn-lg">+ Collect Student Fee</a>
    <a href="/cashier/session" class="btn btn-secondary btn-lg">Drawer Session</a>
  </div>
</div>

<!-- Cashier Today's Collection Stats -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon success">💵</div>
    <div>
      <div class="stat-value">$<%= Number(stats.totalCollection || 0).toLocaleString() %></div>
      <div class="stat-label">Today's Collection (<%= stats.transactionCount || 0 %> Txns)</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon primary">💵</div>
    <div>
      <div class="stat-value">$<%= Number(stats.cash || 0).toLocaleString() %></div>
      <div class="stat-label">Cash in Drawer</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon info">📱</div>
    <div>
      <div class="stat-value">$<%= Number(stats.upi || 0).toLocaleString() %></div>
      <div class="stat-label">UPI / QR Payments</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon warning">💳</div>
    <div>
      <div class="stat-value">$<%= Number(stats.card || 0).toLocaleString() %></div>
      <div class="stat-label">Card / POS</div>
    </div>
  </div>
</div>

<!-- Active Session Status Alert -->
<% if (stats.activeSession) { %>
  <div class="alert alert-success mb-6">
    <span>✓</span>
    <span>
      Active Cash Session: <strong><%= stats.activeSession.id %></strong> |
      Opened with Float: <strong>$<%= stats.activeSession.openingFloat %></strong> |
      Expected Cash: <strong>$<%= stats.activeSession.expectedCash %></strong>
    </span>
  </div>
<% } else { %>
  <div class="alert alert-warning mb-6">
    <span>⚠️</span>
    <span>No active cash drawer session is currently open. A session will auto-open upon your first collection, or you can <a href="/cashier/session">open one here</a>.</span>
  </div>
<% } %>

<!-- Recent Transactions Table -->
<div class="card">
  <div class="card-header">
    <h2 class="card-title">Recent Fee Transactions (Today)</h2>
    <a href="/cashier/collect" class="btn btn-primary btn-sm">+ New Payment</a>
  </div>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Time</th>
          <th>Receipt #</th>
          <th>Student</th>
          <th>Fee Title</th>
          <th>Mode</th>
          <th style="text-align: right;">Amount</th>
          <th style="text-align: right;">Receipt</th>
        </tr>
      </thead>
      <tbody>
        <% if (stats.recentPayments && stats.recentPayments.length > 0) { %>
          <% stats.recentPayments.forEach(p => { %>
            <tr>
              <td><%= new Date(p.createdAt).toLocaleTimeString() %></td>
              <td><code><%= p.receiptNumber %></code></td>
              <td><strong><%= p.studentName %></strong> (<%= p.admissionNumber %>)</td>
              <td><%= p.feeTitle %></td>
              <td><span class="badge badge-info"><%= p.paymentMethod %></span></td>
              <td style="text-align: right;"><strong>$<%= Number(p.amount).toFixed(2) %></strong></td>
              <td style="text-align: right;">
                <a href="/cashier/receipts/<%= p.receiptId %>" class="btn btn-secondary btn-sm">View</a>
                <a href="/cashier/receipts/<%= p.receiptId %>/pdf" target="_blank" class="btn btn-primary btn-sm">PDF</a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 32px;">No transactions completed today yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
