<%- include('../partials/header') %>

<div class="page-header no-print">
  <div>
    <h1 class="page-title">Fee Payment Receipt</h1>
    <div class="page-subtitle">Official computer-generated financial receipt #<%= receipt.receiptNumber %></div>
  </div>
  <div style="display: flex; gap: 10px;">
    <button onclick="window.print()" class="btn btn-primary">🖨️ Print Receipt</button>
    <a href="/cashier/receipts/<%= receipt.id %>/pdf" target="_blank" class="btn btn-secondary">📄 Download Official PDF</a>
    <a href="/cashier/collect" class="btn btn-success">+ Collect Next</a>
  </div>
</div>

<!-- Printable Receipt Paper -->
<div class="receipt-paper">
  <div class="receipt-header">
    <div style="font-size: 28px; margin-bottom: 4px;">🎓</div>
    <div class="receipt-title"><%= school.name %></div>
    <div class="receipt-school"><%= school.address %></div>
    <div class="receipt-school">Email: <%= school.email %> | Phone: <%= school.phone %></div>
    <div style="margin-top: 10px; font-weight: 700; font-size: 14px; letter-spacing: 0.05em; color: var(--primary);">
      OFFICIAL FEE PAYMENT RECEIPT
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 20px; font-size: 13px;">
    <div>
      <div>Receipt Number: <strong><%= receipt.receiptNumber %></strong></div>
      <div>Date: <strong><%= receipt.date %></strong></div>
      <div>Payment Mode: <strong><%= receipt.paymentMethod %></strong></div>
      <div>Txn Reference: <strong><%= receipt.transactionReference || 'N/A' %></strong></div>
    </div>
    <div style="text-align: right;">
      <div>Student: <strong><%= receipt.studentName %></strong></div>
      <div>Admission No: <strong><%= receipt.admissionNumber %></strong></div>
      <div>Class: <strong><%= receipt.className %> - <%= receipt.sectionName %></strong></div>
      <div>Cashier: <strong><%= receipt.cashierName %></strong></div>
    </div>
  </div>

  <div class="table-responsive" style="margin-bottom: 20px;">
    <table class="table">
      <thead>
        <tr>
          <th>Sl</th>
          <th>Fee Component / Description</th>
          <th style="text-align: right;">Amount Paid ($)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>1</td>
          <td><strong><%= receipt.feeTitle %></strong></td>
          <td style="text-align: right;"><strong>$<%= Number(receipt.amountPaid).toFixed(2) %></strong></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div style="display: flex; justify-content: flex-end; margin-bottom: 30px;">
    <div style="width: 280px; background: #f8fafc; border: 1px solid var(--border-color); border-radius: 6px; padding: 12px; font-size: 13px;">
      <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
        <span>Total Paid:</span>
        <strong style="color: var(--success); font-size: 16px;">$<%= Number(receipt.amountPaid).toFixed(2) %></strong>
      </div>
      <% if (receipt.remainingBalance !== undefined) { %>
        <div style="display: flex; justify-content: space-between; color: var(--text-muted); font-size: 12px;">
          <span>Remaining Dues:</span>
          <span>$<%= Number(receipt.remainingBalance).toFixed(2) %></span>
        </div>
      <% } %>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 60px; font-size: 12px; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 12px;">
    <div>Cashier Signature / Official Stamp</div>
    <div>Payer Signature</div>
  </div>
</div>

<%- include('../partials/footer') %>
