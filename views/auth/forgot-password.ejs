<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Reset Password | Edurivo</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0f172a;
      padding: 20px;
    }
    .container-box {
      width: 100%;
      max-width: 420px;
      background: #fff;
      border-radius: var(--radius-lg);
      padding: 36px;
    }
  </style>
</head>
<body>
  <div class="container-box">
    <h2 style="font-size: 22px; font-weight: 700; margin-bottom: 8px;">Reset Password</h2>
    <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">
      Enter your verified institutional email. A secure password recovery link will be dispatched.
    </p>

    <form action="/auth/forgot-password" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label class="form-label" for="email">Institutional Email</label>
        <input type="email" id="email" name="email" class="form-control" required placeholder="user@edurivo.edu">
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%;">Send Reset Link</button>
      <div style="text-align: center; margin-top: 16px;">
        <a href="/auth/login" style="font-size: 13px;">Return to Sign In</a>
      </div>
    </form>
  </div>
</body>
</html>
