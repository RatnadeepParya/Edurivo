<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Homework & Project Assignments</h1>
    <div class="page-subtitle">Assign daily academic tasks and exercises to enrolled classes</div>
  </div>
</div>

<% if (typeof query !== 'undefined' && query && query.success) { %>
  <div class="alert alert-success">Homework assigned and notified to class successfully!</div>
<% } %>

<div class="flex gap-6" style="flex-wrap: wrap; align-items: flex-start;">
  <!-- Create Homework Form -->
  <div class="card" style="flex: 1; min-width: 360px;">
    <div class="card-header">
      <h2 class="card-title">New Homework Assignment</h2>
    </div>
    <form method="POST" action="/teacher/homework">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-row">
        <div class="form-col">
          <label class="form-label" for="hwClass">Target Class *</label>
          <select id="hwClass" name="classId" class="form-control" required>
            <% classes.forEach(cls => { %>
              <option value="<%= cls.id %>"><%= cls.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-col">
          <label class="form-label" for="hwSubject">Subject *</label>
          <select id="hwSubject" name="subjectId" class="form-control" required>
            <% subjects.forEach(sub => { %>
              <option value="<%= sub.id %>"><%= sub.name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-row mt-4">
        <div class="form-col">
          <label class="form-label" for="hwTitle">Assignment Title *</label>
          <input type="text" id="hwTitle" name="title" class="form-control" required placeholder="e.g. Chapter 4 Trigonometry Exercises">
        </div>
        <div class="form-col">
          <label class="form-label" for="hwDue">Submission Due Date *</label>
          <input type="date" id="hwDue" name="dueDate" class="form-control" required>
        </div>
      </div>

      <div class="form-group mt-4">
        <label class="form-label" for="hwInstr">Instructions & Tasks *</label>
        <textarea id="hwInstr" name="instructions" class="form-control" rows="4" required placeholder="Describe task requirements, page numbers, or questions..."></textarea>
      </div>

      <div style="margin-top: 24px; display: flex; justify-content: flex-end;">
        <button type="submit" class="btn btn-primary btn-lg">Publish Homework</button>
      </div>
    </form>
  </div>

  <!-- Active Assignments List -->
  <div class="card" style="flex: 1; min-width: 360px;">
    <div class="card-header">
      <h2 class="card-title">Published Assignments</h2>
    </div>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Assignment</th>
            <th>Class / Subject</th>
            <th>Due Date</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof assignments !== 'undefined' && assignments && assignments.length > 0) { %>
            <% assignments.forEach(hw => { %>
              <tr>
                <td>
                  <strong><%= hw.title %></strong>
                  <div style="font-size: 11px; color: var(--text-muted);"><%= hw.instructions ? hw.instructions.substring(0, 50) + '...' : '' %></div>
                </td>
                <td>
                  <span class="badge badge-info"><%= hw.className || 'Class' %></span>
                  <div style="font-size: 11px; color: var(--text-muted);"><%= hw.subjectName || 'General' %></div>
                </td>
                <td><%= hw.dueDate || 'Open' %></td>
                <td><span class="badge badge-success"><%= hw.status || 'ACTIVE' %></span></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" style="text-align: center; padding: 24px; color: var(--text-muted);">
                No assignments published yet. Use the form to assign homework.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
