<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Fee Status & Receipts</h1>
    <div class="page-subtitle">View active fee invoices, payment status, and download official receipts</div>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon primary">💳</div>
    <div>
      <div class="stat-value">$<%= (summary.totalAssigned || 0).toFixed(2) %></div>
      <div class="stat-label">Total Assigned Fees</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon success">✓</div>
    <div>
      <div class="stat-value">$<%= (summary.totalPaid || 0).toFixed(2) %></div>
      <div class="stat-label">Total Cleared</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon danger">⏳</div>
    <div>
      <div class="stat-value">$<%= (summary.totalBalance || 0).toFixed(2) %></div>
      <div class="stat-label">Outstanding Dues</div>
    </div>
  </div>
</div>

<div class="card mb-6">
  <div class="card-header">
    <h2 class="card-title">Fee Invoices</h2>
  </div>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Invoice / Fee Title</th>
          <th>Due Date</th>
          <th>Total Obligation</th>
          <th>Paid</th>
          <th>Balance Due</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (fees && fees.length > 0) { %>
          <% fees.forEach(f => { %>
            <tr>
              <td><strong><%= f.title %></strong></td>
              <td><%= f.dueDate %></td>
              <td>$<%= Number(f.totalAmount).toFixed(2) %></td>
              <td>$<%= Number(f.paidAmount || 0).toFixed(2) %></td>
              <td><strong style="color: <%= f.balance > 0 ? 'var(--danger)' : 'var(--success)' %>;">$<%= Number(f.balance).toFixed(2) %></strong></td>
              <td><span class="badge <%= f.status === 'PAID' ? 'badge-success' : 'badge-warning' %>"><%= f.status %></span></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 24px;">No fee invoices assigned.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Official Payment Receipts</h2>
  </div>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Receipt #</th>
          <th>Payment Date</th>
          <th>Amount Paid</th>
          <th>Payment Mode</th>
          <th style="text-align: right;">Official Receipt</th>
        </tr>
      </thead>
      <tbody>
        <% if (receipts && receipts.length > 0) { %>
          <% receipts.forEach(rcpt => { %>
            <tr>
              <td><code><%= rcpt.receiptNumber %></code></td>
              <td><%= rcpt.date %></td>
              <td><strong>$<%= Number(rcpt.amountPaid).toFixed(2) %></strong></td>
              <td><%= rcpt.paymentMethod %></td>
              <td style="text-align: right;">
                <a href="/cashier/receipts/<%= rcpt.id %>" class="btn btn-secondary btn-sm">View</a>
                <a href="/cashier/receipts/<%= rcpt.id %>/pdf" class="btn btn-primary btn-sm" target="_blank">Download PDF</a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5" style="text-align: center; color: var(--text-muted); padding: 24px;">No payment receipts found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
